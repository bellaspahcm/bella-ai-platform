+    try {await check('PRODUCTION_BUILD_PRIVATE_HEADER',async()=>{adapter.must(anon.status===401&&cache.includes('private')&&cache.includes('no-store'),'PRODUCTION_PRIVATE_HEADER_NOT_PROVEN');return{status:anon.status,private:true,noStore:true};});}
+    catch {report.headerGateFailed=true;}
+    await check('COURSE_REAL_AUTH_DIAGNOSTIC',diagnoseCourses);
+    await verifyBrowser();
