{
  "buildCommand": "npm run build:prod",
  "framework": "nextjs",
  "installCommand": "npm ci --legacy-peer-deps",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "build": {
    "env": {
      "SKIP_TYPE_CHECK": "true",
      "SKIP_LINT": "true",
      "NODE_OPTIONS": "--max-old-space-size=8192"
    }
  }
}
