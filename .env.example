# ============================================================================
# BELLA ERP - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to Git!
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE (Supabase)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Database Connection (for migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# MONITORING (Sentry)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-auth-token

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_ENV=development

# Logging
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# REDIS (Caching - Optional)
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ----------------------------------------------------------------------------
# EMAIL (SendGrid - Optional)
# ----------------------------------------------------------------------------
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ----------------------------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# ----------------------------------------------------------------------------
# REAL ESTATE MODULE (Optional)
# ----------------------------------------------------------------------------
# Default commission rate (percentage)
DEFAULT_COMMISSION_RATE=3.0

# Default installment count
DEFAULT_INSTALLMENT_COUNT=12

# Reservation expiry (hours)
RESERVATION_EXPIRY_HOURS=48

# ----------------------------------------------------------------------------
# TESTING (Playwright)
# ----------------------------------------------------------------------------
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000

# Test Database (separate from production)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
ENABLE_REAL_ESTATE_MODULE=true
ENABLE_PARTNER_PORTAL=true
ENABLE_MONITORING=true

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Cloudflare R2 Storage (Bella Interior Image CDN) -----------------------
# Account ID from: Cloudflare Dashboard ? R2 Object Storage
R2_ACCOUNT_ID=3c8d589a1d10e0c3a2167a27abd354ab
# Access Key created in: Cloudflare Dashboard ? R2 ? Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name
R2_BUCKET_NAME=bella-production
# Public base URL — set your custom domain here, or use r2.dev URL for testing
# e.g. https://pub-xxxxxxxx.r2.dev  OR  https://cdn.bella-interior.com
R2_PUBLIC_BASE_URL=https://cdn.bella-interior.com
# -----------------------------------------------------------------------------
